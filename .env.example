# Get a free key at https://spoonacular.com/food-api/console#Profile — never commit the real one.
SPOONACULAR_API_KEY=
SPOONACULAR_BASE_URL=https://api.spoonacular.com
# Seconds to wait for Spoonacular before giving up (answered as 504).
SPOONACULAR_TIMEOUT=5
# Seconds a recipe stays in the cache.
CACHE_TTL=3600
