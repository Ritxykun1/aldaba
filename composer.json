{
    "name": "ritxy/aldaba",
    "description": "REST service that looks up recipes by name using the Spoonacular API. Plain PHP, no framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Aldaba\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aldaba\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 -t public public/index.php"
        ],
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
